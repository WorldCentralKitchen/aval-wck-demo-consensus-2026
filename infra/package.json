  "devDependencies": {
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.165.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
