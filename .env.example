# ─────────────────────────────────────────────────────────────────────────────
# Aval environment template — copy to .env (gitignored) and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# AWS — already in .env
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock (filled in once Phase 0c model access is approved)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Coinbase Developer Platform (Phase 0c — sign up + create API key)
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Base Sepolia chain
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532

# EAS issuer wallet (signs all WCK attestations) — Phase 0c
# Generated by scripts/create-wallets.ts; private key kept here, address logged on creation.
EAS_ISSUER_PRIVATE_KEY=
EAS_ISSUER_ADDRESS=

# WCK treasury wallet (sends USDC to vendors) — Phase 0c
# CDP-managed in production, raw key for the demo.
TREASURY_PRIVATE_KEY=
TREASURY_ADDRESS=

# x402 receiver wallet (receives the $0.01 USDC paywall payments) — Phase 0c
# Receiving doesn't need the key, but we keep it so we can sweep funds later.
X402_RECEIVER_PRIVATE_KEY=
X402_RECEIVER_ADDRESS=

# Demo donor-agent wallet (pays the x402 paywall during the demo) — Phase 0c
DEMO_DONOR_PRIVATE_KEY=
DEMO_DONOR_ADDRESS=

# EAS schema UIDs — populated by scripts/register-schemas.ts; the script
# rewrites packages/schemas/src/uids.ts and that file is the source of truth.
# Nothing to set here.

# x402 facilitator (Coinbase-hosted — the public testnet facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Base USDC contract (Base Sepolia)
USDC_BASE_SEPOLIA_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Resource names (overrideable for parallel demo environments)
DDB_TABLE_NAME=aval-records
REKOG_COLLECTION_NAME=aval-recipients-demo
S3_ONBOARDING_BUCKET=aval-onboarding-staging
KMS_PII_ALIAS=alias/aval-pii
